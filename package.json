{
  "name": "stepper",
  "version": "1.0.1",
  "private": true,
  "description": "Browser extension that tracks per-ticket release steps on Azure DevOps.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "preview": "node build.mjs --preview",
    "package": "node build.mjs && node package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^26.6.6",
    "esbuild": "^0.24.2",
    "typescript": "^5.9.3"
  }
}
